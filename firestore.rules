rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function eventPath(eventId) { return /databases/$(database)/documents/events/$(eventId); }
    function eventInfo(eventId) { return get(eventPath(eventId)).data; }
    function isOwner(eventId) {
      return signedIn() && exists(eventPath(eventId)) && eventInfo(eventId).ownerUid == request.auth.uid;
    }
    function eventOpen(eventId) {
      return exists(eventPath(eventId)) && eventInfo(eventId).acceptUploads == true;
    }
    match /events/{eventId} {
      // Event documents have unpredictable UUID IDs; GET requires Firebase Auth.
      allow get: if signedIn();
      // Organiser dashboard queries 'ownerUid == current uid'.
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.auth.token.email is string
        && request.resource.data.keys().hasOnly(['ownerUid','title','date','venue','limit','acceptUploads','manualApproval','galleryLocked','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.venue is string && request.resource.data.venue.size() <= 120
        && request.resource.data.limit is int && request.resource.data.limit >= 1 && request.resource.data.limit <= 50
        && request.resource.data.acceptUploads is bool && request.resource.data.manualApproval is bool && request.resource.data.galleryLocked is bool
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','date','venue','limit','acceptUploads','manualApproval','galleryLocked'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.venue is string && request.resource.data.venue.size() <= 120
        && request.resource.data.limit is int && request.resource.data.limit >= 1 && request.resource.data.limit <= 50
        && request.resource.data.acceptUploads is bool && request.resource.data.manualApproval is bool && request.resource.data.galleryLocked is bool;
      allow delete: if false;
      match /photos/{photoId} {
        function photoVisible() {
          return resource.data.status == 'approved' && eventInfo(eventId).galleryLocked == false;
        }
        allow get, list: if signedIn() && exists(eventPath(eventId))
          && (isOwner(eventId) || resource.data.guestUid == request.auth.uid || photoVisible());
        allow create: if signedIn() && eventOpen(eventId)
          && request.resource.data.keys().hasOnly(['guestUid','guestName','filter','status','storagePath','createdAt'])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string && request.resource.data.guestName.size() >= 2 && request.resource.data.guestName.size() <= 40
          && request.resource.data.filter in ['classic','warm','mono','natural']
          && request.resource.data.status == (eventInfo(eventId).manualApproval == true ? 'pending' : 'approved')
          && request.resource.data.storagePath == 'events/' + eventId + '/' + request.auth.uid + '/' + photoId
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved','hidden','pending'];
        allow delete: if isOwner(eventId);
      }
      match /wishes/{wishId} {
        allow get, list: if signedIn() && exists(eventPath(eventId));
        allow create: if signedIn() && eventOpen(eventId)
          && request.resource.data.keys().hasOnly(['guestUid','guestName','text','createdAt'])
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string && request.resource.data.guestName.size() >= 2 && request.resource.data.guestName.size() <= 40
          && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(eventId);
      }
    }
  }
}
